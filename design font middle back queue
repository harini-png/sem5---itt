#include <stdlib.h>
#include <stdio.h>

typedef struct {
    int* data;
    int size;
    int capacity;
} FrontMiddleBackQueue;

// Helper function to initialize the queue
FrontMiddleBackQueue* frontMiddleBackQueueCreate() {
    FrontMiddleBackQueue* obj = (FrontMiddleBackQueue*)malloc(sizeof(FrontMiddleBackQueue));
    obj->capacity = 2005; // Sufficient size for 1000 push operations
    obj->data = (int*)malloc(obj->capacity * sizeof(int));
    obj->size = 0;
    return obj;
}

// Adds val to the front of the queue
void frontMiddleBackQueuePushFront(FrontMiddleBackQueue* obj, int val) {
    for (int i = obj->size; i > 0; i--) {
        obj->data[i] = obj->data[i - 1];
    }
    obj->data[0] = val;
    obj->size++;
}

// Adds val to the middle of the queue
void frontMiddleBackQueuePushMiddle(FrontMiddleBackQueue* obj, int val) {
    int mid = obj->size / 2;
    for (int i = obj->size; i > mid; i--) {
        obj->data[i] = obj->data[i - 1];
    }
    obj->data[mid] = val;
    obj->size++;
}

// Adds val to the back of the queue
void frontMiddleBackQueuePushBack(FrontMiddleBackQueue* obj, int val) {
    obj->data[obj->size] = val;
    obj->size++;
}

// Removes and returns the front element
int frontMiddleBackQueuePopFront(FrontMiddleBackQueue* obj) {
    if (obj->size == 0) return -1;
    int val = obj->data[0];
    for (int i = 0; i < obj->size - 1; i++) {
        obj->data[i] = obj->data[i + 1];
    }
    obj->size--;
    return val;
}

// Removes and returns the middle element
int frontMiddleBackQueuePopMiddle(FrontMiddleBackQueue* obj) {
    if (obj->size == 0) return -1;
    int mid = (obj->size - 1) / 2;
    int val = obj->data[mid];
    for (int i = mid; i < obj->size - 1; i++) {
        obj->data[i] = obj->data[i + 1];
    }
    obj->size--;
    return val;
}

// Removes and returns the back element
int frontMiddleBackQueuePopBack(FrontMiddleBackQueue* obj) {
    if (obj->size == 0) return -1;
    int val = obj->data[obj->size - 1];
    obj->size--;
    return val;
}

// Free allocated memory
void frontMiddleBackQueueFree(FrontMiddleBackQueue* obj) {
    free(obj->data);
    free(obj);
}

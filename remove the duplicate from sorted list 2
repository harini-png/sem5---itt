#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     struct ListNode *next;
 * };
 */
struct ListNode* deleteDuplicates(struct ListNode* head) {
    if (!head || !head->next) return head;

    // Create a dummy node to seamlessly handle changes to the head of the list
    struct ListNode dummy;
    dummy.val = 0;
    dummy.next = head;

    // 'prev' tracks the last known distinct node before a duplicate sequence
    struct ListNode* prev = &dummy;
    struct ListNode* curr = head;

    while (curr != NULL) {
        bool is_duplicate = false;

        // Check if the current node has the same value as subsequent nodes
        while (curr->next != NULL && curr->val == curr->next->val) {
            is_duplicate = true;
            struct ListNode* temp = curr;
            curr = curr->next;
            free(temp); // Safely free the duplicated node memory
        }

        if (is_duplicate) {
            // 'curr' is currently at the last duplicate node of the sequence.
            // Bridge 'prev' over to the node after the duplicate segment.
            struct ListNode* last_duplicate = curr;
            curr = curr->next;
            prev->next = curr;
            free(last_duplicate); // Free the final duplicate node in the sequence
        } else {
            // No duplicates found for this node; safe to advance 'prev'
            prev = curr;
            curr = curr->next;
        }
    }

    return dummy.next;
}

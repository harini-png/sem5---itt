#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* simplifyPath(char* path) {
    int len = strlen(path);
    

    char** stack = (char**)malloc(len * sizeof(char*));
    int top = 0;

    
    char* token = strtok(path, "/");
    
    while (token != NULL) {
        if (strcmp(token, ".") == 0 || strlen(token) == 0) {
         
        } else if (strcmp(token, "..") == 0) {
           
            if (top > 0) {
                top--;
            }
        } else {
           
            stack[top++] = token;
        }
        token = strtok(NULL, "/");
    }

    char* result = (char*)malloc((len + 2) * sizeof(char));
    result[0] = '\0'; 
    if (top == 0) {
        strcpy(result, "/");
    } else {
        for (int i = 0; i < top; i++) {
            strcat(result, "/");
            strcat(result, stack[i]);
        }
    }
    free(stack);
    
    return result;
}
